# Local web app settings. Copy to .env.local and fill in.
# Real values: `bun run claude-office:env` in personal-infra prints them all.
# That command prints the production BETTER_AUTH_URL; keep the localhost one below,
# or Google sends you back to the live site after sign-in.

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAIL=
MONGODB_URI=
MONGODB_DB=claude-office
